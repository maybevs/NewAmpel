<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AmpelSteuerung.StreamDeck</AssemblyName>
    <RootNamespace>AmpelSteuerung.StreamDeck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Copy plugin assets to output -->
  <ItemGroup>
    <None Include="sdplugin\**" CopyToOutputDirectory="PreserveNewest" LinkBase="sdplugin" />
  </ItemGroup>

</Project>
