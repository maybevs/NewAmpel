<Window x:Class="AmpelSteuerung.App.BeamerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AmpelSteuerung.App.Converters"
        Title="Ampel Beamer"
        WindowStyle="None"
        WindowState="Normal"
        Background="Black"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Standard mode: single display filling the whole screen -->
        <Border Background="{Binding Display1ColorBrush, Converter={StaticResource HexToBrush}}"
                Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <!-- Hidden when idle overlay is active -->
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowIdleOnBeamer}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Stretch="Uniform" Margin="40">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Display1Group}"
                               FontSize="120"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Opacity="0.8"
                               FontFamily="Segoe UI, sans-serif"/>
                    <TextBlock Text="{Binding Display1Time}"
                               FontSize="500"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, monospace"/>
                    <TextBlock Text="{Binding CurrentEnd}"
                               FontSize="100"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Opacity="0.6"
                               FontFamily="Segoe UI, sans-serif"/>
                </StackPanel>
            </Viewbox>
        </Border>

        <!-- Final mode: dual side-by-side displays -->
        <Grid Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}">
            <!-- Hidden when idle overlay is active -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowIdleOnBeamer}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{Binding Display1ColorBrush, Converter={StaticResource HexToBrush}}">
                <Viewbox Stretch="Uniform" Margin="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display1Group}"
                                   FontSize="100"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8"
                                   FontFamily="Segoe UI, sans-serif"/>
                        <TextBlock Text="{Binding Display1Time}"
                                   FontSize="400"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, monospace"/>
                        <TextBlock Text="{Binding CurrentEnd}"
                                   FontSize="80"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"
                                   FontFamily="Segoe UI, sans-serif"/>
                    </StackPanel>
                </Viewbox>
            </Border>

            <Rectangle Grid.Column="1" Fill="#111111"/>

            <Border Grid.Column="2"
                    Background="{Binding Display2ColorBrush, Converter={StaticResource HexToBrush}}">
                <Viewbox Stretch="Uniform" Margin="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display2Group}"
                                   FontSize="100"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8"
                                   FontFamily="Segoe UI, sans-serif"/>
                        <TextBlock Text="{Binding Display2Time}"
                                   FontSize="400"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, monospace"/>
                        <TextBlock Text="{Binding CurrentEnd}"
                                   FontSize="80"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"
                                   FontFamily="Segoe UI, sans-serif"/>
                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Idle overlay: shown when timer stopped and idle mode active -->
        <Border Background="Black"
                Visibility="{Binding ShowIdleOnBeamer, Converter={StaticResource BoolToVis}}">
            <Viewbox Stretch="Uniform" Margin="60">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="800">
                    <!-- Idle message (top area) -->
                    <TextBlock Text="{Binding IdleMessage}"
                               Visibility="{Binding ShowIdleMessage, Converter={StaticResource BoolToVis}}"
                               FontSize="200"
                               FontWeight="SemiBold"
                               Foreground="#FFCC00"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="1600"
                               FontFamily="Segoe UI, sans-serif"
                               Margin="0,0,0,40"/>
                    <!-- Clock (bottom area or full) -->
                    <TextBlock Text="{Binding CurrentClock}"
                               Visibility="{Binding ShowIdleClock, Converter={StaticResource BoolToVis}}"
                               FontSize="500"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, monospace"/>
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
</Window>
