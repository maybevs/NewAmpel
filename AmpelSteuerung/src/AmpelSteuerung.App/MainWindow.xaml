<Window x:Class="AmpelSteuerung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AmpelSteuerung.App.Converters"
        mc:Ignorable="d"
        Title="Bogensport Ampelsteuerung"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MODERN BUTTON BASE                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1E1E35"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#282845"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14142A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action (green) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1A3D2A"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="#2ECC71"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#214D34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#132E1F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger action (red) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3D1A1A"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4D2222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E1212"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning action (amber) -->
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3D2E0A"/>
            <Setter Property="BorderBrush" Value="#F1C40F"/>
            <Setter Property="Foreground" Value="#F1C40F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4D3A12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2006"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info (blue) -->
        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#152040"/>
            <Setter Property="BorderBrush" Value="#5B6BF5"/>
            <Setter Property="Foreground" Value="#8898FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2A50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#101830"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (purple) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#251840"/>
            <Setter Property="BorderBrush" Value="#8E6FD8"/>
            <Setter Property="Foreground" Value="#A88CE8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#302050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small neutral button -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <!-- Color swatch button -->
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emergency Stop button -->
        <Style x:Key="EmergencyButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#FF4444"
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#911111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BigButton alias for final mode data triggers -->
        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TOP: Dual Display Preview                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Display 1 (Left) -->
            <Border Grid.Column="0"
                    Background="{Binding Display1ColorBrush, Converter={StaticResource HexToBrush}}"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,6,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11" Foreground="White" Opacity="0.6" FontWeight="SemiBold"
                               FontFamily="Segoe UI, sans-serif" Margin="2,0,0,0">
                        <Run Text="LINKS ("/>
                        <Run Text="{Binding Display1SideLabel, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display1Time}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, monospace"/>
                        <TextBlock Text="{Binding Display1Group}" FontSize="22" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Info Panel -->
            <Border Grid.Column="1" Margin="4,0"
                    Background="{StaticResource BgCardBrush}"
                    CornerRadius="14"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    Padding="12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PhaseText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="PASSE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding CurrentEnd}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TimerStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <!-- Final mode arrow counts -->
                    <StackPanel Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Text="Pfeile" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="L:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ArrowCountLeftText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,10,0"/>
                            <TextBlock Text="R:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ArrowCountRightText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Display 2 (Right) -->
            <Border Grid.Column="2"
                    Background="{Binding Display2ColorBrush, Converter={StaticResource HexToBrush}}"
                    CornerRadius="16"
                    Padding="20"
                    Margin="6,0,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11" Foreground="White" Opacity="0.6" FontWeight="SemiBold"
                               FontFamily="Segoe UI, sans-serif" Margin="2,0,0,0">
                        <Run Text="RECHTS ("/>
                        <Run Text="{Binding Display2SideLabel, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display2Time}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, monospace"/>
                        <TextBlock Text="{Binding Display2Group}" FontSize="22" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MIDDLE: All Controls                                       -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,4,16,4"
                      Padding="0,0,4,0">
            <StackPanel>
                <!-- ── STEUERUNG ─────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="STEUERUNG" Style="{StaticResource SectionLabel}"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="▶  START" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartTimerCommand}"
                                    IsEnabled="{Binding IsStartEnabled}" Width="128"/>
                            <Button Content="⏸  PAUSE" Style="{StaticResource WarningButton}"
                                    Command="{Binding PauseTimerCommand}"
                                    IsEnabled="{Binding IsPauseEnabled}" Width="128"/>
                            <Button Content="▶  WEITER" Style="{StaticResource InfoButton}"
                                    Command="{Binding ResumeTimerCommand}"
                                    IsEnabled="{Binding IsResumeEnabled}" Width="128"/>
                            <Button Content="⏹  STOP" Style="{StaticResource DangerButton}"
                                    Command="{Binding StopTimerCommand}" Width="128"/>
                            <Button Content="↺  RESET" Style="{StaticResource ModernButton}"
                                    Command="{Binding ResetTimerCommand}" Width="128"/>
                            <Button Content="⏩  SKIP" Style="{StaticResource AccentButton}"
                                    Command="{Binding SkipTimerCommand}"
                                    IsEnabled="{Binding IsSkipEnabled}" Width="128"/>
                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="⚠  NOTFALL-STOPP (F5)" Style="{StaticResource EmergencyButton}"
                                    Command="{Binding EmergencyStopCommand}" Width="260"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── GROUP / TIMES / PASSE ─────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Group Selection -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="GRUPPE / STARTGRUPPE" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="AB" Style="{StaticResource InfoButton}" Width="80"
                                        Command="{Binding SetGroupABCommand}"/>
                                <Button Content="CD" Style="{StaticResource InfoButton}" Width="80"
                                        Command="{Binding SetGroupCDCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="Startgruppe:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="AB zuerst" Style="{StaticResource SmallButton}"
                                        Command="{Binding SetStartGroupABCommand}"/>
                                <Button Content="CD zuerst" Style="{StaticResource SmallButton}"
                                        Command="{Binding SetStartGroupCDCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Timer Durations -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ZEITEN" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Schießzeit (s):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="60" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="60"/>
                                <Button Content="90" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="90"/>
                                <Button Content="120" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="120"/>
                                <Button Content="240" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="240"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBox Text="{Binding TimerDuration, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                <TextBlock Text="s" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Vorbereitungszeit (s):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBox Text="{Binding PreparationTime, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                <TextBlock Text="s" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Anzeige-Format:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <RadioButton Content="Min:Sek" GroupName="TimeFormat"
                                             IsChecked="{Binding IsTimeFormatMinutes}"
                                             Command="{Binding SetTimeFormatToMinutesCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                <RadioButton Content="Sekunden" GroupName="TimeFormat"
                                             IsChecked="{Binding IsTimeFormatSeconds}"
                                             Command="{Binding SetTimeFormatToSecondsCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Passe -->
                    <Border Grid.Column="4" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PASSE" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Button Content="◀ Zurück" Style="{StaticResource SmallButton}"
                                        Command="{Binding PreviousEndCommand}"/>
                                <TextBlock Text="{Binding CurrentEnd}" FontSize="24" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="14,0"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button Content="Vor ▶" Style="{StaticResource SmallButton}"
                                        Command="{Binding NextEndCommand}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Gesamt:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding TotalEnds, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── FINAL MODE: SIDE SELECTION ────────────────────── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                        Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}"
                        BorderBrush="#3D2E0A">
                    <StackPanel>
                        <TextBlock Text="FINAL-MODUS: SEITE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding FinalsSingleDisplay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Einzel-Display (Split-Ansicht)" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Command="{Binding SetStartSideLeftCommand}" Width="180">
                                <Button.Content>
                                    <TextBlock Text="◀ Links starten (L)" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                        <Setter Property="Background" Value="#152040"/>
                                        <Setter Property="BorderBrush" Value="#5B6BF5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStartSideLeft}" Value="True">
                                                <Setter Property="Background" Value="#1A3D2A"/>
                                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetStartSideRightCommand}" Width="180">
                                <Button.Content>
                                    <TextBlock Text="Rechts starten (R) ▶" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                        <Setter Property="Background" Value="#152040"/>
                                        <Setter Property="BorderBrush" Value="#5B6BF5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStartSideRight}" Value="True">
                                                <Setter Property="Background" Value="#1A3D2A"/>
                                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="↔ Seitenwechsel" Style="{StaticResource AccentButton}"
                                    Command="{Binding SwitchSideCommand}" Width="180"/>
                            <Button Content="⇄ Display tauschen" Style="{StaticResource SmallButton}"
                                    Command="{Binding SwapDisplaySidesCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── MANUAL COLOR OVERRIDE ─────────────────────────── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="MANUELLE FARBÜBERSCHREIBUNG" Style="{StaticResource SectionLabel}"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource ColorSwatchButton}" Background="#CC2020" Content="ROT"
                                    Command="{Binding SetColorRedCommand}"/>
                            <Button Style="{StaticResource ColorSwatchButton}" Background="#1DAA50" Content="GRÜN"
                                    Command="{Binding SetColorGreenCommand}"/>
                            <Button Style="{StaticResource ColorSwatchButton}" Background="#D4A017" Content="GELB"
                                    Command="{Binding SetColorYellowCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── IDLE DISPLAY (visible when stopped) ──────────────── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                        Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}"
                        BorderBrush="#2A2A55">
                    <StackPanel>
                        <TextBlock Text="ANZEIGE IM LEERLAUF (M)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                        <!-- Mode selection -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                            <RadioButton GroupName="IdleMode" Content="🕐 Uhrzeit"
                                         IsChecked="{Binding IsIdleModeClock}"
                                         Command="{Binding SetIdleModeClockCommand}"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                            <RadioButton GroupName="IdleMode" Content="💬 Nachricht"
                                         IsChecked="{Binding IsIdleModeMessage}"
                                         Command="{Binding SetIdleModeMessageCommand}"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                            <RadioButton GroupName="IdleMode" Content="🕐+💬 Beides"
                                         IsChecked="{Binding IsIdleModeBoth}"
                                         Command="{Binding SetIdleModeBothCommand}"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                            <RadioButton GroupName="IdleMode" Content="✕ Aus"
                                         IsChecked="{Binding IsIdleModeOff}"
                                         Command="{Binding SetIdleModeOffCommand}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                        </WrapPanel>

                        <!-- Message input -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="Nachricht:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="IdleMessageTextBox"
                                     Text="{Binding IdleMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Width="340" MaxLength="200"
                                     HorizontalContentAlignment="Left"/>
                            <Button Content="✕" Style="{StaticResource SmallButton}"
                                    Command="{Binding ClearIdleMessageCommand}"
                                    Padding="8,6" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Scroll indicator -->
                        <TextBlock Text="{Binding IdleScrollText}" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,8"/>

                        <!-- Quick messages -->
                        <TextBlock Text="Schnellnachrichten:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding QuickMessages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.SetQuickMessageCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                            CommandParameter="{Binding}"
                                            FontSize="11" Padding="10,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── PRESETS ───────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PRESETS" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberPath="Name"
                                      Width="280"
                                      Margin="0,0,8,0"/>
                            <Button Content="▶ Preset anwenden" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyPresetCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PresetStatus}" FontSize="11" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BOTTOM: Status Bar                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0A16" Padding="14,10" Margin="0"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- COM Port -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="COM-Port:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableComPorts}"
                              SelectedItem="{Binding SelectedComPort}"
                              Width="100" FontSize="12"/>
                    <Button Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshComPortsCommand}"
                            Padding="6,4" FontSize="14" Margin="4,0" Content="⟳"/>
                    <Button Content="Verbinden" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectSerialCommand}"
                            FontSize="12" Padding="12,6"/>
                    <Button Content="Trennen" Style="{StaticResource DangerButton}"
                            Command="{Binding DisconnectSerialCommand}"
                            FontSize="12" Padding="12,6"/>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSerialConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSerialConnected}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Sound + Beamer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sound:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                    <CheckBox IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding AvailableScreens}"
                              SelectedIndex="{Binding SelectedScreenIndex}"
                              Width="200" FontSize="11"
                              Margin="0,0,6,0"/>
                    <Button Content="Beamer (F11)" Style="{StaticResource AccentButton}"
                            Command="{Binding ToggleBeamerCommand}"
                            FontSize="12" Padding="14,6"/>
                    <TextBlock Text="{Binding SerialError}" FontSize="11" Foreground="#FF6666"
                               Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
