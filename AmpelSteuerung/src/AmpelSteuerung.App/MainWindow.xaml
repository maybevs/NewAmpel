<Window x:Class="AmpelSteuerung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AmpelSteuerung.App.Converters"
        mc:Ignorable="d"
        Title="Bogensport Ampelsteuerung"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:StateToVisibilityConverter x:Key="StateToVis"/>
        <converters:ModeStateToVisibilityConverter x:Key="ModeStateToVis"/>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MODERN BUTTON BASE                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1E1E35"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#282845"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14142A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action (green) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1A3D2A"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="#2ECC71"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#214D34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#132E1F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger action (red) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3D1A1A"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4D2222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E1212"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning action (amber) -->
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3D2E0A"/>
            <Setter Property="BorderBrush" Value="#F1C40F"/>
            <Setter Property="Foreground" Value="#F1C40F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4D3A12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2006"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info (blue) -->
        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#152040"/>
            <Setter Property="BorderBrush" Value="#5B6BF5"/>
            <Setter Property="Foreground" Value="#8898FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2A50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#101830"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (purple) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#251840"/>
            <Setter Property="BorderBrush" Value="#8E6FD8"/>
            <Setter Property="Foreground" Value="#A88CE8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#302050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small neutral button -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <!-- Color swatch button -->
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emergency Stop button -->
        <Style x:Key="EmergencyButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#FF4444"
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#911111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BigButton alias for final mode data triggers -->
        <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="280"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LIVE-ZONE: Display Preview + Context Controls              -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0A0A16" Padding="16,16,16,12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,2">
            <StackPanel>
                <!-- ── DISPLAY PREVIEW (full width, no center block) ──── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Display 1 (Left) -->
                    <Border Grid.Column="0"
                            Background="{Binding Display1ColorBrush, Converter={StaticResource HexToBrush}}"
                            CornerRadius="16"
                            Padding="20"
                            MinHeight="140">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontSize="11" Foreground="White" Opacity="0.6" FontWeight="SemiBold"
                                       FontFamily="Segoe UI, sans-serif" Margin="2,0,0,0">
                                <Run Text="LINKS ("/>
                                <Run Text="{Binding Display1SideLabel, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Display1Time}"
                                           FontSize="56"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, monospace"/>
                                <TextBlock Text="{Binding Display1Group}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" Opacity="0.85"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Display 2 (Right) -->
                    <Border Grid.Column="2"
                            Background="{Binding Display2ColorBrush, Converter={StaticResource HexToBrush}}"
                            CornerRadius="16"
                            Padding="20"
                            MinHeight="140">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontSize="11" Foreground="White" Opacity="0.6" FontWeight="SemiBold"
                                       FontFamily="Segoe UI, sans-serif" Margin="2,0,0,0">
                                <Run Text="RECHTS ("/>
                                <Run Text="{Binding Display2SideLabel, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Display2Time}"
                                           FontSize="56"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, monospace"/>
                                <TextBlock Text="{Binding Display2Group}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" Opacity="0.85"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── STATUS BAR under displays ──────────────────────── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PhaseText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text=" │ " Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding CurrentEnd}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text=" │ " Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding CurrentGroup}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    <!-- Final mode arrow counts -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text=" │ " Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Text="L:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ArrowCountLeftText}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,8,0"/>
                        <TextBlock Text="R:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ArrowCountRightText}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── CONTEXT-AWARE CONTROLS ─────────────────────────── -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Context buttons -->
                    <WrapPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- === STANDARD MODE BUTTONS === -->

                        <!-- Idle: START -->
                        <Button Content="▶  START" Style="{StaticResource PrimaryButton}" Width="140"
                                Command="{Binding StartTimerCommand}" FontSize="15" Padding="18,12">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="standard:Idle|EndCompleted">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <!-- Shooting: PAUSE, SKIP -->
                        <Button Content="⏸  PAUSE" Style="{StaticResource WarningButton}" Width="128"
                                Command="{Binding PauseTimerCommand}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="standard:Shooting">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <Button Content="⏩  SKIP" Style="{StaticResource AccentButton}" Width="128"
                                Command="{Binding SkipTimerCommand}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="standard:Shooting">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <!-- Paused: WEITER, STOP -->
                        <Button Content="▶  WEITER" Style="{StaticResource InfoButton}" Width="128"
                                Command="{Binding ResumeTimerCommand}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="both:Paused|EmergencyStopped">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <Button Content="⏹  STOP" Style="{StaticResource DangerButton}" Width="128"
                                Command="{Binding StopTimerCommand}"/>

                        <!-- EndCompleted: NÄCHSTE PASSE (standard), RESET -->
                        <Button Content="↺  RESET" Style="{StaticResource ModernButton}" Width="128"
                                Command="{Binding ResetTimerCommand}"
                                Visibility="{Binding MatchPhaseString, Converter={StaticResource StateToVis}, ConverterParameter=EndCompleted}"/>

                        <!-- === FINAL MODE BUTTONS === -->

                        <!-- Final Idle: START -->
                        <Button Content="▶  START" Style="{StaticResource PrimaryButton}" Width="140"
                                Command="{Binding StartTimerCommand}" FontSize="15" Padding="18,12">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="final:Idle|EndCompleted">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <!-- Final Idle: LINKS/RECHTS -->
                        <Button Command="{Binding SetStartSideLeftCommand}" Width="180">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="final:Idle|EndCompleted">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                            <Button.Content>
                                <TextBlock Text="◀ Links starten (L)" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                    <Setter Property="Background" Value="#152040"/>
                                    <Setter Property="BorderBrush" Value="#5B6BF5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartSideLeft}" Value="True">
                                            <Setter Property="Background" Value="#1A3D2A"/>
                                            <Setter Property="BorderBrush" Value="#2ECC71"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetStartSideRightCommand}" Width="180">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="final:Idle|EndCompleted">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                            <Button.Content>
                                <TextBlock Text="Rechts starten (R) ▶" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                    <Setter Property="Background" Value="#152040"/>
                                    <Setter Property="BorderBrush" Value="#5B6BF5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartSideRight}" Value="True">
                                            <Setter Property="Background" Value="#1A3D2A"/>
                                            <Setter Property="BorderBrush" Value="#2ECC71"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Final Shooting: SKIP/WECHSEL -->
                        <Button Content="↔  SKIP / WECHSEL" Style="{StaticResource AccentButton}" Width="180"
                                Command="{Binding SkipTimerCommand}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="final:Shooting">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                        <!-- Final Idle: Seitenwechsel -->
                        <Button Content="↔ Seitenwechsel" Style="{StaticResource AccentButton}" Width="160"
                                Command="{Binding SwitchSideCommand}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource ModeStateToVis}" ConverterParameter="final:Idle|EndCompleted">
                                    <Binding Path="IsFinalMode"/>
                                    <Binding Path="MatchPhaseString"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>

                    </WrapPanel>

                    <!-- Right: EMERGENCY STOP (always visible) -->
                    <Button Grid.Column="1" Content="⚠  NOTFALL-STOPP (F5)" Style="{StaticResource EmergencyButton}"
                            Command="{Binding EmergencyStopCommand}" Width="220" VerticalAlignment="Center"
                            Margin="16,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SETTINGS-ZONE: TabControl                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" Margin="16,12,16,4" Background="Transparent"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                        CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"
                                        BorderBrush="Transparent" BorderThickness="1,1,1,0" Margin="2,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="{StaticResource BgCardBrush}"/>
                                        <Setter TargetName="TabBd" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="#1C1C30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- TAB: Wettkampf                                        -->
            <!-- ══════════════════════════════════════════════════════ -->
            <TabItem Header="⚔ Wettkampf">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Preset -->
                                <RowDefinition Height="Auto"/> <!-- Sep -->
                                <RowDefinition Height="Auto"/> <!-- Modus -->
                                <RowDefinition Height="Auto"/> <!-- Sep -->
                                <RowDefinition Height="Auto"/> <!-- Gruppen -->
                                <RowDefinition Height="Auto"/> <!-- Sep -->
                                <RowDefinition Height="Auto"/> <!-- Zeiten -->
                                <RowDefinition Height="Auto"/> <!-- Sep -->
                                <RowDefinition Height="Auto"/> <!-- Passe -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Preset -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PRESET" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ListBox ItemsSource="{Binding Presets}"
                                         SelectedItem="{Binding SelectedPreset}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         Margin="0,0,0,6">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,6,6"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="#1E1E35" BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="120">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1A3D2A"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2ECC71"/>
                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#282845"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected" Value="True"/>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="Background" Value="#214D34"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="▶ Anwenden" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ApplyPresetCommand}" Padding="14,8"/>
                                    <Button Content="✎ Bearbeiten" Style="{StaticResource InfoButton}"
                                            Command="{Binding EditPresetCommand}" Padding="14,8"/>
                                    <Button Content="＋ Neu" Style="{StaticResource ModernButton}"
                                            Command="{Binding NewPresetCommand}" Padding="14,8"/>
                                    <Button Content="🗑 Löschen" Style="{StaticResource DangerButton}"
                                            Command="{Binding DeletePresetCommand}" Padding="14,8" FontSize="11"/>
                                    <TextBlock Text="{Binding PresetStatus}" FontSize="11" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sep -->
                            <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10"
                                       Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Row 2: Modus -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MODUS" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="Standard" GroupName="Mode"
                                                 IsChecked="{Binding IsFinalMode, Converter={StaticResource InverseBool}}"
                                                 Command="{Binding SetModeStandardCommand}"
                                                 Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,20,0"/>
                                    <RadioButton Content="Final" GroupName="Mode"
                                                 IsChecked="{Binding IsFinalMode}"
                                                 Command="{Binding SetModeFinalCommand}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}">
                                    <CheckBox IsChecked="{Binding FinalsSingleDisplay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Einzel-Display (Split-Ansicht)" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sep -->
                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10"
                                       Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Row 4: Gruppen -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="GRUPPEN" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="AB" Style="{StaticResource InfoButton}" Width="80"
                                            Command="{Binding SetGroupABCommand}"/>
                                    <Button Content="CD" Style="{StaticResource InfoButton}" Width="80"
                                            Command="{Binding SetGroupCDCommand}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Startgruppe:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="AB zuerst" Style="{StaticResource SmallButton}"
                                            Command="{Binding SetStartGroupABCommand}"/>
                                    <Button Content="CD zuerst" Style="{StaticResource SmallButton}"
                                            Command="{Binding SetStartGroupCDCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sep -->
                            <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10"
                                       Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Row 6: Zeiten -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="ZEITEN" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="6" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Schießzeit:" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Width="120"/>
                                    <TextBox Text="{Binding TimerDuration, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                    <TextBlock Text="s" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Schnellwahl:" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="20,0,8,0"/>
                                    <Button Content="60" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="60"/>
                                    <Button Content="90" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="90"/>
                                    <Button Content="120" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="120"/>
                                    <Button Content="240" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="240"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Vorbereitungszeit:" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Width="120"/>
                                    <TextBox Text="{Binding PreparationTime, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                    <TextBlock Text="s" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sep -->
                            <Separator Grid.Row="7" Grid.ColumnSpan="2" Margin="0,10"
                                       Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Row 8: Passe -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="PASSE" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="8" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="◀ Zurück" Style="{StaticResource SmallButton}"
                                            Command="{Binding PreviousEndCommand}"/>
                                    <TextBlock Text="{Binding CurrentEnd}" FontSize="22" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="14,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Content="Vor ▶" Style="{StaticResource SmallButton}"
                                            Command="{Binding NextEndCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gesamt:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding TotalEnds, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- TAB: Anzeige                                          -->
            <!-- ══════════════════════════════════════════════════════ -->
            <TabItem Header="📺 Anzeige">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                        <StackPanel Margin="4">

                            <!-- Leerlauf-Modus -->
                            <TextBlock Text="LEERLAUF-MODUS" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                <RadioButton GroupName="IdleMode" Content="🕐 Uhrzeit"
                                             IsChecked="{Binding IsIdleModeClock}"
                                             Command="{Binding SetIdleModeClockCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                                <RadioButton GroupName="IdleMode" Content="💬 Nachricht"
                                             IsChecked="{Binding IsIdleModeMessage}"
                                             Command="{Binding SetIdleModeMessageCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                                <RadioButton GroupName="IdleMode" Content="🕐+💬 Beides"
                                             IsChecked="{Binding IsIdleModeBoth}"
                                             Command="{Binding SetIdleModeBothCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                                <RadioButton GroupName="IdleMode" Content="✕ Aus"
                                             IsChecked="{Binding IsIdleModeOff}"
                                             Command="{Binding SetIdleModeOffCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}"/>
                            </WrapPanel>

                            <!-- Message input -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Nachricht:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="IdleMessageTextBox"
                                         Text="{Binding IdleMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Width="340" MaxLength="200"
                                         HorizontalContentAlignment="Left"/>
                                <Button Content="Senden" Style="{StaticResource SmallButton}"
                                        Command="{Binding SetQuickMessageCommand}"
                                        CommandParameter="{Binding IdleMessage}"
                                        Margin="4,0,0,0"/>
                                <Button Content="✕" Style="{StaticResource SmallButton}"
                                        Command="{Binding ClearIdleMessageCommand}"
                                        Padding="8,6" Margin="4,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{Binding IdleScrollText}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,8"/>

                            <!-- Quick messages -->
                            <TextBlock Text="Schnellnachrichten:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding QuickMessages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.SetQuickMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                FontSize="11" Padding="10,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,14" Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Anzeige-Format -->
                            <TextBlock Text="ANZEIGE-FORMAT" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel Margin="0,0,0,10">
                                <RadioButton Content="Min:Sek" GroupName="TimeFormat"
                                             IsChecked="{Binding IsTimeFormatMinutes}"
                                             Command="{Binding SetTimeFormatToMinutesCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                <RadioButton Content="Sekunden" GroupName="TimeFormat"
                                             IsChecked="{Binding IsTimeFormatSeconds}"
                                             Command="{Binding SetTimeFormatToSecondsCommand}"
                                             Foreground="{StaticResource TextPrimaryBrush}"/>
                            </WrapPanel>

                            <Separator Margin="0,4,0,14" Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Manuelle Farbe -->
                            <TextBlock Text="MANUELLE FARBÜBERSCHREIBUNG" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#CC2020" Content="ROT"
                                        Command="{Binding SetColorRedCommand}"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#1DAA50" Content="GRÜN"
                                        Command="{Binding SetColorGreenCommand}"/>
                                <Button Style="{StaticResource ColorSwatchButton}" Background="#D4A017" Content="GELB"
                                        Command="{Binding SetColorYellowCommand}"/>
                            </WrapPanel>

                            <Separator Margin="0,4,0,14" Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Display-Zuordnung -->
                            <TextBlock Text="DISPLAY-ZUORDNUNG" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⇄ Display tauschen" Style="{StaticResource SmallButton}"
                                        Command="{Binding SwapDisplaySidesCommand}"/>
                                <TextBlock FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="Display 1 = "/>
                                    <Run Text="{Binding Display1SideLabel, Mode=OneWay}"/>
                                    <Run Text=", Display 2 = "/>
                                    <Run Text="{Binding Display2SideLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- TAB: Verbindung                                       -->
            <!-- ══════════════════════════════════════════════════════ -->
            <TabItem Header="⚙ Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                        <StackPanel Margin="4">

                            <!-- Sound -->
                            <TextBlock Text="SOUND" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Sound aktiv" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Lautstärke:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" Width="90"/>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SoundVolume}" Width="200"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SoundVolume, StringFormat={}{0}%}" FontSize="12" Margin="8,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Separator Margin="0,10" Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Beamer -->
                            <TextBlock Text="BEAMER" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding AvailableScreens}"
                                          SelectedIndex="{Binding SelectedScreenIndex}"
                                          Width="260" FontSize="11" Margin="0,0,8,0"/>
                                <Button Content="Beamer (F11)" Style="{StaticResource AccentButton}"
                                        Command="{Binding ToggleBeamerCommand}"
                                        FontSize="12" Padding="14,6"/>
                            </StackPanel>

                            <Separator Margin="0,10" Background="{StaticResource BorderSubtleBrush}"/>

                            <!-- Font-Modus -->
                            <TextBlock Text="FONT-MODUS" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Content="BDF (Pixel)" GroupName="FontMode"
                                             IsChecked="{Binding IsBdfMode}"
                                             Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                                <RadioButton Content="TTF (Vektor)" GroupName="FontMode"
                                             IsChecked="{Binding IsTtfMode}"
                                             Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Helligkeit -->
                            <TextBlock Text="HELLIGKEIT" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="10" Maximum="100" Value="{Binding Brightness}" Width="200"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" FontSize="12" Margin="8,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BOTTOM: Status Bar with Connection Controls                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0A16" Padding="10,6" Margin="0"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Connection controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AvailableComPorts}"
                              SelectedItem="{Binding SelectedComPort}"
                              Width="90" FontSize="11" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshComPortsCommand}"
                            Padding="4,2" FontSize="12" Content="⟳" Margin="0,0,4,0"/>
                    <Button Content="Verbinden" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectSerialCommand}"
                            FontSize="11" Padding="8,4" Margin="0,0,2,0"
                            Visibility="{Binding IsSerialConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <Button Content="Trennen" Style="{StaticResource DangerButton}"
                            Command="{Binding DisconnectSerialCommand}"
                            FontSize="11" Padding="8,4" Margin="0,0,2,0"
                            Visibility="{Binding IsSerialConnected, Converter={StaticResource BoolToVis}}"/>
                    <Ellipse Width="8" Height="8" Margin="8,0,4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSerialConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSerialConnected}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Status info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sound" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <CheckBox IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center"/>
                    <TextBlock Text=" │ " Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentEnd}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Beamer -->
                <Button Grid.Column="2" Content="Beamer (F11)" Style="{StaticResource AccentButton}"
                        Command="{Binding ToggleBeamerCommand}"
                        FontSize="11" Padding="10,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
