<Window x:Class="AmpelSteuerung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:AmpelSteuerung.App.Converters"
        mc:Ignorable="d"
        Title="Bogensport Ampelsteuerung"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#1E1E2E"
        Foreground="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Button base style -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#3B3B5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4E4E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2A44"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="EmergencyButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Background" Value="#CC0000"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="24,12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: Dual Display Preview -->
        <Grid Grid.Row="0" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Display 1 -->
            <Border Grid.Column="0"
                    Background="{Binding Display1ColorBrush, Converter={StaticResource HexToBrush}}"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="12" Foreground="White" Opacity="0.7" FontWeight="SemiBold">
                        <Run Text="LINKS ("/>
                        <Run Text="{Binding Display1SideLabel, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display1Time}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="{Binding Display1Group}" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Opacity="0.9"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Width="120">
                <TextBlock Text="{Binding PhaseText}" FontSize="14" FontWeight="Bold" Foreground="#AAAAAA"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="PASSE" FontSize="11" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentEnd}" FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TimerStatus}" FontSize="12" Foreground="#AAAAAA"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <!-- Final mode arrow counts -->
                <StackPanel Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="#888" HorizontalAlignment="Center" Text="Pfeile"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="L:" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding ArrowCountLeftText}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="2,0,8,0"/>
                        <TextBlock Text="R:" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding ArrowCountRightText}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="2,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Display 2 -->
            <Border Grid.Column="2"
                    Background="{Binding Display2ColorBrush, Converter={StaticResource HexToBrush}}"
                    CornerRadius="12"
                    Padding="16"
                    Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="12" Foreground="White" Opacity="0.7" FontWeight="SemiBold">
                        <Run Text="RECHTS ("/>
                        <Run Text="{Binding Display2SideLabel, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Display2Time}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="{Binding Display2Group}" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Opacity="0.9"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MIDDLE: Controls -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,6">
            <StackPanel>
                <!-- Timer Controls -->
                <Border Background="#2B2B40" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="STEUERUNG" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="▶ START" Style="{StaticResource BigButton}"
                                    Command="{Binding StartTimerCommand}"
                                    IsEnabled="{Binding IsStartEnabled}"
                                    Background="#2D7D2D" Width="130"/>
                            <Button Content="⏸ PAUSE" Style="{StaticResource BigButton}"
                                    Command="{Binding PauseTimerCommand}"
                                    IsEnabled="{Binding IsPauseEnabled}"
                                    Background="#B8860B" Width="130"/>
                            <Button Content="▶ WEITER" Style="{StaticResource BigButton}"
                                    Command="{Binding ResumeTimerCommand}"
                                    IsEnabled="{Binding IsResumeEnabled}"
                                    Background="#2D6D9E" Width="130"/>
                            <Button Content="⏹ STOP" Style="{StaticResource BigButton}"
                                    Command="{Binding StopTimerCommand}"
                                    Background="#8B2222" Width="130"/>
                            <Button Content="↺ RESET" Style="{StaticResource BigButton}"
                                    Command="{Binding ResetTimerCommand}"
                                    Width="130"/>
                            <Button Content="⏩ SKIP" Style="{StaticResource BigButton}"
                                    Command="{Binding SkipTimerCommand}"
                                    IsEnabled="{Binding IsSkipEnabled}"
                                    Background="#6B4C9A" Width="130"/>
                        </WrapPanel>
                        <!-- Emergency Stop -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="⚠ NOTFALL-STOPP (F5)" Style="{StaticResource EmergencyButton}"
                                    Command="{Binding EmergencyStopCommand}" Width="240"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Group, Duration, End -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Group selection -->
                    <Border Grid.Column="0" Background="#2B2B40" CornerRadius="8" Padding="16" Margin="0,0,4,8">
                        <StackPanel>
                            <TextBlock Text="GRUPPE / STARTGRUPPE" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="AB" Style="{StaticResource BigButton}" Width="80"
                                        Command="{Binding SetGroupABCommand}" Background="#3D5A80"/>
                                <Button Content="CD" Style="{StaticResource BigButton}" Width="80"
                                        Command="{Binding SetGroupCDCommand}" Background="#3D5A80"/>
                            </WrapPanel>
                            <TextBlock Text="Startgruppe:" FontSize="11" Foreground="#888" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="AB zuerst" Style="{StaticResource SmallButton}"
                                        Command="{Binding SetStartGroupABCommand}" Background="#2B4570"/>
                                <Button Content="CD zuerst" Style="{StaticResource SmallButton}"
                                        Command="{Binding SetStartGroupCDCommand}" Background="#2B4570"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Timer durations -->
                    <Border Grid.Column="1" Background="#2B2B40" CornerRadius="8" Padding="16" Margin="4,0,4,8">
                        <StackPanel>
                            <TextBlock Text="ZEITEN" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
                            <TextBlock Text="Schießzeit (s):" FontSize="11" Foreground="#888" Margin="0,0,0,2"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="60" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="60"/>
                                <Button Content="90" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="90"/>
                                <Button Content="120" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="120"/>
                                <Button Content="240" Style="{StaticResource SmallButton}" Click="SetDuration_Click" Tag="240"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBox Text="{Binding TimerDuration, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" FontSize="14" Background="#1E1E2E" Foreground="White"
                                         BorderBrush="#555" Padding="4" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="s" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Vorbereitungszeit (s):" FontSize="11" Foreground="#888" Margin="0,8,0,2"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBox Text="{Binding PreparationTime, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" FontSize="14" Background="#1E1E2E" Foreground="White"
                                         BorderBrush="#555" Padding="4" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="s" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Passe -->
                    <Border Grid.Column="2" Background="#2B2B40" CornerRadius="8" Padding="16" Margin="4,0,0,8">
                        <StackPanel>
                            <TextBlock Text="PASSE" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="◀ Zurück" Style="{StaticResource SmallButton}"
                                        Command="{Binding PreviousEndCommand}"/>
                                <TextBlock Text="{Binding CurrentEnd}" FontSize="24" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="12,0" Foreground="White"/>
                                <Button Content="Vor ▶" Style="{StaticResource SmallButton}"
                                        Command="{Binding NextEndCommand}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Gesamt: " FontSize="13" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding TotalEnds, UpdateSourceTrigger=PropertyChanged}"
                                         Width="50" FontSize="14" Background="#1E1E2E" Foreground="White"
                                         BorderBrush="#555" Padding="4" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Final Mode: Side Selection -->
                <Border Background="#2B2B40" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                        Visibility="{Binding IsFinalMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="FINAL-MODUS: SEITE" FontSize="13" FontWeight="Bold" Foreground="#E8A030" Margin="0,0,0,10"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Command="{Binding SetStartSideLeftCommand}" Width="180">
                                <Button.Content>
                                    <TextBlock Text="◀ Links starten (L)"/>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                        <Setter Property="Background" Value="#3D5A80"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStartSideLeft}" Value="True">
                                                <Setter Property="Background" Value="#2D7D2D"/>
                                                <Setter Property="BorderBrush" Value="#44DD44"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SetStartSideRightCommand}" Width="180">
                                <Button.Content>
                                    <TextBlock Text="Rechts starten (R) ▶"/>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                        <Setter Property="Background" Value="#3D5A80"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStartSideRight}" Value="True">
                                                <Setter Property="Background" Value="#2D7D2D"/>
                                                <Setter Property="BorderBrush" Value="#44DD44"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="↔ Seitenwechsel" Style="{StaticResource BigButton}"
                                    Command="{Binding SwitchSideCommand}" Background="#6B4C9A" Width="180"/>
                            <Button Content="⇄ Display tauschen" Style="{StaticResource SmallButton}"
                                    Command="{Binding SwapDisplaySidesCommand}" Background="#555"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Manual Color Override -->
                <Border Background="#2B2B40" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="MANUELLE FARBÜBERSCHREIBUNG" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource ColorButton}" Background="#CC0000" Content="ROT"
                                    Command="{Binding SetColorRedCommand}"/>
                            <Button Style="{StaticResource ColorButton}" Background="#00AA00" Content="GRÜN"
                                    Command="{Binding SetColorGreenCommand}"/>
                            <Button Style="{StaticResource ColorButton}" Background="#DDAA00" Content="GELB"
                                    Command="{Binding SetColorYellowCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <Border Background="#2B2B40" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="PRESETS" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberPath="Name"
                                      Width="280"
                                      FontSize="14"
                                      Background="#1E1E2E"
                                      Foreground="Black"
                                      Margin="0,0,8,0"/>
                            <Button Content="▶ Preset anwenden" Style="{StaticResource SmallButton}"
                                    Command="{Binding ApplyPresetCommand}"
                                    Background="#2D7D2D"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PresetStatus}" FontSize="12" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM: Configuration -->
        <Border Grid.Row="2" Background="#252538" Padding="12" Margin="12,6,12,12" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- COM Port -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="COM-Port:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                    <ComboBox ItemsSource="{Binding AvailableComPorts}"
                              SelectedItem="{Binding SelectedComPort}"
                              Width="100" FontSize="13" Background="#1E1E2E" Foreground="Black"/>
                    <Button Content="⟳" Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshComPortsCommand}"
                            Padding="8,4" FontSize="16" Margin="4,0"/>
                    <Button Content="Verbinden" Style="{StaticResource SmallButton}"
                            Command="{Binding ConnectSerialCommand}"
                            Background="#2D7D2D"/>
                    <Button Content="Trennen" Style="{StaticResource SmallButton}"
                            Command="{Binding DisconnectSerialCommand}"
                            Background="#8B2222"/>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSerialConnected}" Value="True">
                                        <Setter Property="Fill" Value="#00CC00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSerialConnected}" Value="False">
                                        <Setter Property="Fill" Value="#CC0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="13" VerticalAlignment="Center" Foreground="#AAAAAA"/>
                </StackPanel>

                <!-- Sound toggle + Beamer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sound:" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                    <CheckBox IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AvailableScreens}"
                              SelectedIndex="{Binding SelectedScreenIndex}"
                              Width="200" FontSize="12"
                              Background="#1E1E2E" Foreground="Black"
                              Margin="12,0,4,0"/>
                    <Button Content="Beamer (F11)" Style="{StaticResource SmallButton}"
                            Command="{Binding ToggleBeamerCommand}"/>
                    <TextBlock Text="{Binding SerialError}" FontSize="11" Foreground="#FF6666"
                               Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
